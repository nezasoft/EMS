@using Microsoft.AspNetCore.Components.Authorization
@using Client.ApplicationState
@inject DepartmentState departmentState

<AuthorizeView>
    <Authorized>
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="">
                    Hi, @context.User.Identity!.Name
                </a>
                <button aria-expanded="@(!collapseNavMenu)" title="Navigation menu" class="navbar-toggler d-sm-none" @onclick="ToggleNavMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
            </div>
        </div>
        <!-- Sidebar -->
        <div class="sidebar collapse d-sm-block @(collapseNavMenu ? "collapse" : "show")">
            <nav class="flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link p-2" href="/home/dashboard" Match="NavLinkMatch.All">
                        <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                        Home
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link p-2" href="counter">
                        <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span>
                        Counter
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link p-2" @onclick="ShowAdminMenuContainer" style="cursor:pointer;" 
                    href="javascript:void()">
                        <div class="hstack gap-1">
                            <span class="bi bi-person-fill fs-3 text-center" aria-hidden="true"> style="margin-top:-2rem"
                            </span>
                            <span>Administration</span>
                        </div>    
                    </NavLink>
                    <a class="nav-link  p-2 text-white" style="margin-left:5rem; visibility;@cssStyle">
                        <div class="hstack">
                            <span class="bi bi-people fs-5 text-center" aria-hiddebn="true" style="margin-top:-2rem">
                            </span>
                            <span>Users</span>
                        </div>
                    </a>
                </div>
                <div class="nav-item px-3" style="margin-top:@DepartmentMargin">
                    <NavLink class="nav-link p-2" @onclick="ShowDepartmentContainer" style="cursor:pointer;" 
                    href="javascript:void()">
                        <div class="hstack gap-1">
                            <div class="hstack gap-1">
                                <span class="bi bi-backpack4-fill fs-3 text-center" aria-hidden="true" style="margin-top:-2rem">
                                </span>
                                <span>Department</span>
                            </div>
                        </div>
                    </NavLink>
                    <div class="nav-link p-2 text-white" style="margin-left:5rem; visibility:@DepartmentCssStyle">
                        <ul class="list-group">
                            <li style="list-style:none" class="cusorStyle">
                                <a class="nav-link p-2" @onclick="GeneralDepartmentClicked">
                                    <div class="hstack text-wrap">
                                        <span class="bi bi-file-medical fs-5 text-center" aria-hidden="true" style="margin-top:-2rem"></span>
                                        <span class="fs-6">General</span>
                                    </div>
                                </a>
                            </li>
                            <li style="list-style:none" class="cusorStyle">
                                <a class="nav-link p-2" >
                                    <div class="hstack text-wrap">
                                        <span class="bi bi-substack fs-5 text-center" aria-hidden="true" style="margin-top:-2rem"></span>
                                        <span class="fs-6">Department</span>
                                    </div>
                                </a>
                            </li>
                            <li style="list-style:none" class="cusorStyle">
                                <a class="nav-link p-2" >
                                    <div class="hstack text-wrap">
                                        <span class="bi bi-chevron-bar-contract fs-5 text-center" aria-hidden="true" style="margin-top:-2rem"></span>
                                        <span class="fs-6">Branch</span>
                                    </div>
                                </a>
                            </li>

                        </ul>
                    </div>

                </div>
            </nav>
        </div>
    </Authorized>
</AuthorizeView>
@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
    public string DepartmentMargin { get; set; } = "-3rem";
    public string CssStyle = "hidden";
    public bool ShowHide { get; set; } = false;

    private void ShowAdminMenuContainer()
    {
        ShowHide = !ShowHide;
        if(ShowHide)
        {
            DepartmentMargin = "0";
            CssStyle = "visible";
        }
        else
        {
            DepartmentMargin = "-3.5rem";
            CssStyle = "hidden";
        }
    }

    private string DepartmentCssStyle = "hidden";
    public bool ShowHideDepartment { get; set; } = false;
    private void ShowDepartmentContainer()
    {
        ShowHideDepartment = !ShowHideDepartment;
        if(ShowHideDepartment)
        {
            DepartmentCssStyle = "visible";
        }
        else
        {
            DepartmentCssStyle = "hidden";
        }
    }

    void GeneralDepartmentClicked()
    {
        departmentState.GeneralDepartmentClicked();

    }




}
